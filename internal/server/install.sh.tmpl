#!/bin/sh
# Arcatum runner installer — generated by arcatum-server, do not edit by hand.
#
#   curl -LsSf {{.BootstrapURL}}/arcatum_runner/install.sh | sh
#
# It installs the runner as a systemd service. The runner then generates its own
# private key, sends only a certificate request, and waits until an operator approves
# it in the Arcatum web UI. The private key never leaves this host.
#
# Strictly POSIX shell: the command above pipes it into sh, which on Debian and Ubuntu is
# dash. A bashism fails on the very first line ("set: Illegal option -o pipefail") on
# exactly the hosts this is meant for. There are no pipelines here, so -e and -u are the
# whole of what pipefail would have added.
set -eu

BOOTSTRAP_URL="{{.BootstrapURL}}"
API_URL="{{.APIURL}}"
BIN_DIR="/usr/local/bin"
CONF_DIR="/etc/arcatum-runner"
DATA_DIR="/var/lib/arcatum-runner"
PKI_DIR="$DATA_DIR/pki"
SERVICE="arcatum-runner"

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" = "0" ] || die "run as root (e.g. pipe into 'sudo sh')"
command -v curl >/dev/null || die "curl is required"

# The server publishes one binary per platform; pick the matching one.
case "$(uname -s)" in
  Linux) OS=linux ;;
  *) die "unsupported operating system: $(uname -s)" ;;
esac
case "$(uname -m)" in
  x86_64|amd64) ARCH=amd64 ;;
  aarch64|arm64) ARCH=arm64 ;;
  *) die "unsupported architecture: $(uname -m)" ;;
esac

RUNNER_ID="$(hostname -s)"
say "installing arcatum-runner for $RUNNER_ID ($OS/$ARCH)"

say "downloading binary"
install -d -m 0755 "$BIN_DIR"
curl -LsSf "$BOOTSTRAP_URL/arcatum_runner/arcatum-runner-$OS-$ARCH" -o "$BIN_DIR/$SERVICE.new" \
  || die "cannot download the runner binary — is $BOOTSTRAP_URL reachable?"
chmod 0755 "$BIN_DIR/$SERVICE.new"
mv "$BIN_DIR/$SERVICE.new" "$BIN_DIR/$SERVICE"

say "fetching trust material"
install -d -m 0700 "$DATA_DIR" "$PKI_DIR"
install -d -m 0755 "$CONF_DIR"
# The CA certificate and the dispatch-signing public key are public by design: the CA
# lets this host verify the server, the public key lets it verify signed jobs.
curl -LsSf "$BOOTSTRAP_URL/arcatum_runner/ca.pem" -o "$PKI_DIR/ca.pem" || die "cannot fetch ca.pem"
curl -LsSf "$BOOTSTRAP_URL/arcatum_runner/dispatch-signing.pub" -o "$PKI_DIR/dispatch-signing.pub" \
  || die "cannot fetch dispatch-signing.pub"
chmod 0644 "$PKI_DIR/ca.pem" "$PKI_DIR/dispatch-signing.pub"

# Keep an existing configuration: re-running the installer should upgrade the binary,
# not silently reset how this host is configured.
if [ -f "$CONF_DIR/runner.toml" ]; then
  say "keeping existing $CONF_DIR/runner.toml"
else
  say "writing $CONF_DIR/runner.toml"
  cat > "$CONF_DIR/runner.toml" <<EOF
# Generated by install.sh from $BOOTSTRAP_URL
[runner]
server        = "$API_URL"
enroll_server = "$BOOTSTRAP_URL"
poll_interval = "30s"
data_dir      = "$DATA_DIR"

[tls]
ca_cert = "$PKI_DIR/ca.pem"
cert    = "$PKI_DIR/runner.pem"
key     = "$PKI_DIR/runner.key"

[signing]
public_key = "$PKI_DIR/dispatch-signing.pub"
EOF
  chmod 0640 "$CONF_DIR/runner.toml"
fi

say "installing systemd service"
cat > "/etc/systemd/system/$SERVICE.service" <<EOF
[Unit]
Description=Arcatum backup runner
Documentation=$BOOTSTRAP_URL
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$BIN_DIR/$SERVICE -config $CONF_DIR/runner.toml
Restart=always
RestartSec=10
# The runner reads the files it backs up, so it runs privileged; everything else is
# locked down.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
StateDirectory=arcatum-runner

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable "$SERVICE" >/dev/null 2>&1 || true
systemctl restart "$SERVICE"

cat <<EOF

arcatum-runner is installed and running as "$RUNNER_ID".

It has generated its own private key and sent a certificate request to Arcatum.
Nothing is trusted yet — approve this host in the web UI:

    {{.APIURL}}/  →  tab "Runnery"  →  "schválit"

Until then the service keeps retrying; that is expected. Useful commands:

    systemctl status $SERVICE
    journalctl -u $SERVICE -f
EOF
